# Sao chép thành .env.local (đã .gitignore). KHÔNG commit giá trị thật.

# URL Backend API (TV1 output: api_https_url). Local mock: http://127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8080

# msal = Microsoft Entra External ID (OIDC, PKCE) | mock = chọn user giả lập từ tests/mock_api
VITE_AUTH_MODE=msal

# App registration (SPA) trong tenant Entra External ID — Client ID KHÔNG phải secret
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Dạng https://<tenant-subdomain>.ciamlogin.com/
VITE_ENTRA_AUTHORITY=https://your-tenant.ciamlogin.com/
# Scope của API app registration, ví dụ api://<api-client-id>/access_as_user
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
