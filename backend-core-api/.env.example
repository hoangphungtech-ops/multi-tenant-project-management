# Local development only. Do not use these values in production.
POSTGRES_DB=backenddb
POSTGRES_USER=backend
POSTGRES_PASSWORD=local_dev_only
DB_URL=jdbc:postgresql://localhost:5432/backenddb
DB_USERNAME=backend
DB_PASSWORD=local_dev_only

# Entra ID: fill these from your App Registration.
ENTRA_ISSUER_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
ENTRA_AUDIENCE=api://YOUR_API_CLIENT_ID

# Azurite connection string for local development.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://127.0.0.1
AZURE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURE_QUEUE_ENDPOINT=http://127.0.0.1:10001/devstoreaccount1
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzYF...REPLACE_WITH_OFFICIAL_AZURITE_KEY
AZURE_QUEUE_NAME=export-jobs
AZURE_BLOB_CONTAINER=exports

# Set true only for local demo without Entra ID. Never enable in production.
APP_SECURITY_DEMO_MODE=true
